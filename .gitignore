# ---- Python -----------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- Model weights ----------------------------------------------------
# Checkpoints are large binaries and are regenerated by training.
*.pt
checkpoints/
checkpoints_*/
runs/

# ---- Training data ----------------------------------------------------
# Lichess PGN dumps are ~18 MB each and download automatically; see
# pretrain_supervised.py --urls
data/*.pgn
data/*.pgn.zst
data/*.npy
data/my_games.pgn
data/opening_seeds.json

# ---- Run output -------------------------------------------------------
logs/
*.log

# ---- LaTeX build artifacts -------------------------------------------
*.aux
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
docs/report/*.log

# ---- Editor / OS ------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Local safety copies made while debugging ------------------------
*.bak

# ---- LaTeX intermediates from the report build -----------------------
docs/ieee_report/*.aux
docs/ieee_report/*.bbl
docs/ieee_report/*.blg
docs/ieee_report/*.out
docs/ieee_report/*.log
docs/ieee_report/[a-e][0-9].log
docs/ieee_report/build*.log
docs/ieee_report/bib.log
